  return (
    <ReactLenis
      root
      options={{
        lerp: 0.05,
        smoothWheel: true,
        wheelMultiplier: 0.9,
      }}
    >
      <main
        ref={containerRef}
        className={`min-h-screen overflow-hidden transition-colors duration-500 relative ${
          isLightMode ? "bg-zinc-50 text-zinc-900" : "bg-[#090909] text-whisper"
