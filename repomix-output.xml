    });
  }, { scope: containerRef, dependencies: [filteredTemplates] });

  const activeColorToken = useMemo(() => {
    const activeItem = templateItems.find(t => t.slug === activeTemplateSlug);
    return colorMap[activeItem?.accent || "violet"];
