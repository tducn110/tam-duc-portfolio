        {/* Galaxy Background consistent with Portfolio layout */}
        {!isLightMode && <ThreeBackground />}
        <CursorHalo />

        {/* Back and Theme Toggle Bar */}
        <div className="absolute top-6 left-0 right-0 z-50">
