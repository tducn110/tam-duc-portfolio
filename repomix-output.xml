    email: row.email,
    phone: row.phone ?? undefined,
    serviceType: row.service_type,
    budget: row.budget ?? undefined,
    message: row.message,
    status: row.status,
    notificationStatus: row.notification_status,
    createdAt: row.created_at,
    updatedAt: row.updated_at,
  };
}
