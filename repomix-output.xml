                  <Button
                    variant="ghost"
                    size="sm"
                    className="p-1.5 h-8 w-8 hover:bg-red-500/10 rounded-lg text-[#6b6b6b] hover:text-red-400 border-transparent hover:border-transparent"
                    onClick={(e) => handleDelete(e, lead.id)}
                    aria-label={`Delete lead from ${lead.name}`}
                  >
                    <Trash2 size={14} />
                  </Button>
                </div>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  );
}
